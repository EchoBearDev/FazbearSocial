      { id:'SKIN3', name:'Ojo', cost:50, url:'https://placehold.co/100x100/111/f59e0b?text=EYE' }
    ];
    shopContainer.innerHTML = STORE_ITEMS.map(it => `
      <div style="background:#101010;padding:8px;border-radius:8px;">
        <div style="display:flex;align-items:center;gap:8px"><img src="${it.url}" style="width:56px;height:56px;border-radius:6px" /><div><strong>${escapeHtml(it.name)}</strong><div class="small">馃挵 ${it.cost}</div></div></div>
        <div style="margin-top:8px"><button class="pizza-btn" onclick="buyGear('${it.id}')">Comprar</button></div>
      </div>
    `).join('');
  }

  async function buyGear(itemId) {
    toast('Funci贸n de compra no implementada en demo');
  }

  // ========== DB structure check (diagnostic) ==========
  async function checkFriendTables() {
    try {
      const { error } = await supabase.from('friend_requests').select('id').limit(1);
      if (error) { features.friendTablesReady = false; safeLog('friend_requests check', error); } else features.friendTablesReady = true;
    } catch (err) { features.friendTablesReady = false; safeLog('checkFriendTables unexpected', err); }
  }
  checkFriendTables();

  // ========== Startup ==========
  // handleAuth will set a temp id if needed; startApp triggers actual UI flows
  USER_ID = getUserId();
  IS_ADMIN = (USER_ID === ADMIN_USER_ID);
  document.getElementById('display-user-id')?.textContent = USER_ID;
  // Start app immediately for convenience (your original flow may require PIN/login)
  startApp();

  </script>
