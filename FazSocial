  function switchTab(tab) {
    currentTab = tab;
    document.querySelectorAll('.page').forEach(p => p.classList.add('hidden'));
    document.getElementById(tab).classList.remove('hidden');
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    const btn = document.getElementById('tab-' + tab);
    if (btn) btn.classList.add('active');
    // lazy load
    if (tab === 'feed') loadFeed();
    if (tab === 'map') loadMap();
    if (tab === 'cameras') loadCameras();
    if (tab === 'chat') loadChat();
    if (tab === 'private-chat') { renderIncomingRequests(); renderFriendsList(); renderChatsList(); }
    if (tab === 'profile') loadProfile();
  }

  function openPostModal() { document.getElementById('post-modal').classList.remove('hidden'); }
  function closePostModal() { document.getElementById('post-modal').classList.add('hidden'); }

  function handleSearch() { const q = document.getElementById('search-input').value.trim(); loadFeed(false, q); }

  // ========== Initialisation ==========
  async function initApp() {
    try {
      setupRealtime();
      startPresenceTicker();
      await loadProfile();
      await loadFeed();
      await loadCameras();
      await loadChat();
      await loadShop();
      await loadMap();
    } catch (err) { safeLog('initApp error', err); }
  }

  // minimal loadShop to avoid missing errors
  async function loadShop() {
    const shopContainer = document.getElementById('shop-items');
    shopContainer.innerHTML = '';
    const STORE_ITEMS = [
      { id:'SKIN1', name:'Parche Pirate Cove', cost:10, url:'https://placehold.co/100x100/5b21b6/fff?text=PARCHE' },
