  <style>
    /* Visual / layout styles (kept similar to prior versions) */
    body { font-family: 'VT323', monospace; background:#111; color:#d1d5db; margin:0; min-height:100vh; }
    .monitor { background:#1a1a1a; border:5px solid #5a5a5a; box-shadow:0 0 30px rgba(147,51,234,0.35); width:100%; max-width:1000px; margin:0 auto; min-height:100vh; display:flex; flex-direction:column; }
