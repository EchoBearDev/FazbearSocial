  <!-- Post modal -->
  <div id="post-modal" class="hidden" style="position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.8);z-index:90;padding:16px;">
    <div style="background:#101010;padding:16px;border-radius:10px;max-width:600px;width:100%;border:3px solid #9333ea;">
      <h3 style="margin-top:0;color:#d7b3ff">NUEVA TEOR脥A</h3>
      <textarea id="post-content" class="comment-input" style="height:140px"></textarea>
      <div style="margin-top:8px;display:flex;gap:8px;align-items:center;">
        <input id="post-file" type="file" accept="image/*" />
        <button class="pizza-btn" id="submit-post-btn" onclick="submitPost()">PUBLICAR</button>
