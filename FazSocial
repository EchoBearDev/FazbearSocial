  // ========== Friends & Private Chats ==========
  async function sendFriendRequest(targetId) {
    try {
      const payload = { requester_id: USER_ID, target_id: targetId, status: 'pending' };
      const { data, error } = await supabase.from('friend_requests').insert(payload).select();
      if (error) {
        safeLog('sendFriendRequest error', error);
        if (/does not exist|unknown column/i.test(error.message || '')) features.friendTablesReady = false;
        return { error };
      }
      return { data };
    } catch (err) { safeLog('sendFriendRequest unexpected', err); return { error: err }; }
  }

  async function loadIncomingFriendRequests() {
    try {
      const { data, error } = await supabase.from('friend_requests').select('*').eq('target_id', USER_ID).eq('status','pending').order('created_at',{ascending:false});
      if (error) { safeLog('loadIncomingFriendRequests', error); if (/does not exist|unknown column/i.test(error.message||'')) features.friendTablesReady=false; return { data: [], error }; }
      return { data, error };
    } catch (err) { safeLog('loadIncomingFriendRequests unexpected', err); return { data: [], error: err }; }
  }

  async function respondFriendRequest(requestId, accept) {
    try {
      const { data: req, error: getErr } = await supabase.from('friend_requests').select('*').eq('id', requestId).single();
      if (getErr || !req) { safeLog('respond get error', getErr); return { error: getErr || 'not found'}; }
      const newStatus = accept ? 'accepted' : 'rejected';
      const { error: updErr } = await supabase.from('friend_requests').update({ status: newStatus }).eq('id', requestId);
      if (updErr) { safeLog('respond update error', updErr); return { error: updErr }; }
      if (accept) {
        const [a,b] = [req.requester_id, req.target_id].sort();
        const { error: insErr } = await supabase.from('friendships').insert({ user_a:a, user_b:b }).select();
        if (insErr) safeLog('friendship insert warning', insErr);
      }
      return { ok:true };
    } catch (err) { safeLog('respondFriendRequest unexpected', err); return { error: err }; }
  }

  async function loadFriends() {
    try {
      const { data: aList } = await supabase.from('friendships').select('*').eq('user_a', USER_ID);
      const { data: bList } = await supabase.from('friendships').select('*').eq('user_b', USER_ID);
      const friends = [];
      (aList || []).forEach(r => r && friends.push(r.user_b));
      (bList || []).forEach(r => r && friends.push(r.user_a));
      return friends;
    } catch (err) { safeLog('loadFriends error', err); return []; }
  }

  async function createOrGetPrivateChat(friendId) {
    try {
      const [a,b] = [USER_ID, friendId].sort();
      const { data: exists } = await supabase.from('private_chats').select('*').or(`(user_a.eq.${a},user_b.eq.${b})`).limit(1).maybeSingle();
      if (exists) return exists;
      const { data: created, error } = await supabase.from('private_chats').insert({ user_a:a, user_b:b }).select().single();
      if (error) { safeLog('create chat error', error); return null; }
      return created;
    } catch (err) { safeLog('createOrGetPrivateChat unexpected', err); return null; }
  }

  async function sendPrivateMessage(chatId, text) {
    try {
      if (!chatId) return { error:'no chat id' };
      const { data, error } = await supabase.from('private_messages').insert({ chat_id: chatId, sender_id: USER_ID, text }).select();
      if (error) { safeLog('sendPrivateMessage error', error); if (/does not exist/i.test(error.message||'')) features.friendTablesReady=false; return { error }; }
      // best-effort update last_message_at
      try { await supabase.from('private_chats').update({ last_message_at: new Date().toISOString() }).eq('id', chatId); } catch(e){/*ignore*/}
      return { data };
    } catch (err) { safeLog('sendPrivateMessage unexpected', err); return { error: err }; }
  }

  async function loadPrivateMessages(chatId, limit=200) {
    try {
      const { data, error } = await supabase.from('private_messages').select('*').eq('chat_id', chatId).order('created_at',{ascending:true}).limit(limit);
      if (error) { safeLog('loadPrivateMessages error', error); return []; }
      return data || [];
