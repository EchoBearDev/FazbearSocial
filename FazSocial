    .friend-dot { position:absolute; width:36px; height:36px; border-radius:50%; overflow:hidden; border:2px solid #fff; box-shadow:0 0 10px rgba(147,51,234,0.6); background:#222; display:flex; align-items:center; justify-content:center; }
    .toast { position:fixed; left:50%; transform:translateX(-50%); bottom:90px; background:#222; padding:10px 16px; border-radius:10px; border:2px solid #9333ea; color:#fff; z-index:80; }
