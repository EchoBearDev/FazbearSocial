    try {
      const friends = await loadFriends();
      await renderFriendsOnMap(friends);
    } catch (err) { safeLog('loadMap err', err); }
  }

  // ========== Realtime subscriptions ==========
  function setupRealtime() {
    try {
      // comments insert -> update UI
      supabase.channel('comments_channel')
        .on('postgres_changes', { event:'INSERT', schema:'public', table:'comments' }, payload => {
          loadComments(payload.new.post_id);
          // if it's for you, show notification
          supabase.from('posts').select('user_id').eq('id', payload.new.post_id).single()
            .then(res => { if (res?.data?.user_id === USER_ID && payload.new.user_id !== USER_ID) { localStorage.setItem('hasNewComment','true'); } });
        })
        .subscribe();

      // likes updates
      supabase.channel('likes_channel')
        .on('postgres_changes', { event:'INSERT', schema:'public', table:'likes' }, payload => {
          loadFeed();
        })
        .subscribe();

      // chat messages
      supabase.channel('chat_channel')
        .on('postgres_changes', { event:'INSERT', schema:'public', table:'chat_messages' }, payload => {
          appendChatMessage(payload.new);
        })
        .subscribe();

      // private messages
      supabase.channel('private_messages_channel')
        .on('postgres_changes', { event:'INSERT', schema:'public', table:'private_messages' }, payload => {
          const m = payload.new;
          // if current open chat is same, append; else notify
          if (currentOpenChatId && currentOpenChatId === m.chat_id) {
            const thread = document.getElementById('private-chat-threads');
            const bubble = `<div class="message-bubble"><div class="small" style="font-weight:bold">${escapeHtml(m.sender_id)}</div><div>${escapeHtml(m.text)}</div><div class="small" style="color:#9ca3af">${new Date(m.created_at).toLocaleString()}</div></div>`;
            thread.insertAdjacentHTML('beforeend', bubble);
            thread.scrollTop = thread.scrollHeight;
          } else {
            toast(`Mensaje privado de ${m.sender_id}`);
            // update chats list
            renderChatsList();
          }
        })
        .subscribe();

      // friend requests (insert/update)
      supabase.channel('friend_requests_channel')
        .on('postgres_changes', { event:'INSERT', schema:'public', table:'friend_requests' }, payload => {
          if (payload.new.target_id === USER_ID) {
            renderIncomingRequests(); toast('Nueva solicitud de amistad');
          }
        })
        .on('postgres_changes', { event:'UPDATE', schema:'public', table:'friend_requests' }, payload => {
          if (payload.new.requester_id === USER_ID && payload.new.status === 'accepted') {
            renderFriendsList(); toast('Tu solicitud fue aceptada');
          }
          if (payload.new.target_id === USER_ID) renderIncomingRequests();
        })
        .subscribe();

      // profiles presence updates
      supabase.channel('profiles_channel')
        .on('postgres_changes', { event:'UPDATE', schema:'public', table:'profiles' }, payload => {
          // re-render friends list/map if relevant
          renderFriendsList(); // inexpensive for small friend lists
        })
        .subscribe();
    } catch (err) { safeLog('setupRealtime error', err); }
  }

