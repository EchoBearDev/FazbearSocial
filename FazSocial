  // ========== Presence & Map ==========
  const staticPositions = [
    { left:'8%', top:'12%' }, { left:'28%', top:'18%' }, { left:'52%', top:'14%' }, { left:'74%', top:'22%' },
    { left:'18%', top:'58%' }, { left:'44%', top:'54%' }, { left:'68%', top:'62%' }, { left:'86%', top:'46%' }
  ];

  async function loadFriendsPresence(friends) {
    if (!friends || friends.length === 0) return {};
    try {
      const { data } = await supabase.from('profiles').select('user_id,name,avatar_url,last_active').in('user_id', friends);
      const map = {};
      (data || []).forEach(p => map[p.user_id] = p);
      return map;
    } catch (err) { safeLog('loadFriendsPresence err', err); return {}; }
  }

  async function renderFriendsOnMap(friends) {
    const canvas = document.getElementById('map-canvas');
    if (!canvas) return;
    // remove existing dots
    const existing = canvas.querySelectorAll('.friend-dot'); existing.forEach(n=>n.remove());
    const presence = await loadFriendsPresence(friends);
    friends.forEach((fid, idx) => {
      const pos = staticPositions[idx % staticPositions.length];
      const info = presence[fid] || {};
      const isOnline = info.last_active && (new Date(info.last_active) > new Date(Date.now() - 60000));
      const dot = document.createElement('div');
      dot.className = 'friend-dot';
      dot.style.left = pos.left;
      dot.style.top = pos.top;
      dot.title = `${fid}${isOnline?' (online)':' (offline)'}`;
      const img = document.createElement('img');
      img.src = info.avatar_url || DEFAULT_AVATAR;
      img.style.width='100%'; img.style.height='100%'; img.style.objectFit='cover';
      dot.appendChild(img);
      canvas.appendChild(dot);
      if (!isOnline && info.last_active) {
        const last = new Date(info.last_active);
        const age = Date.now() - last.getTime();
        if (age < 5 * 60 * 1000) {
          const anim = ANIMATRONIC_STATUS[Math.floor(Math.random()*ANIMATRONIC_STATUS.length)];
          toast(`${anim.name} ha alcanzado a ${fid}`, 6000);
        }
      }
    });
    // update textual report
    const report = document.getElementById('map-events');
    report.innerHTML = `<div class="small">Amigos en mapa: ${friends.length}</div>`;
  }

