      const current = await getProfileInfo(USER_ID);
      const up = {
        user_id: USER_ID,
        name,
        bio,
        avatar_url: avatarUrl || current.avatar,
        pin: current.pin || null,
        faz_tokens: current.faz_tokens || 0,
      };
      await supabase.from('profiles').upsert(up, { onConflict: 'user_id' });
      // update denormalized avatars in other tables (best-effort)
      await supabase.from('posts').update({ name: name, avatar: up.avatar_url }).eq('user_id', USER_ID);
      await supabase.from('chat_messages').update({ name: name, avatar: up.avatar_url }).eq('user_id', USER_ID);
