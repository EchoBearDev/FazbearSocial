    .message-bubble { background:#222; padding:8px 10px; border-radius:10px; margin-bottom:8px; max-width:70%; }
    .message-bubble.me { background:#6b21a8; color:white; margin-left:auto; }
    .avatar-base { width:36px; height:36px; border-radius:50%; object-fit:cover; border:2px solid #9333ea; }
    .hidden { display:none !important; }
    .small { font-size:0.85rem; }
  </style>
</head>
<body>
